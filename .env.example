# Copy and configure for your own isolated database. Never use production data.
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
HOST=127.0.0.1
APP_MODE=demo
DATABASE_URL=postgresql://biztrust_app:replace-me@127.0.0.1:15432/biztrust_dev
# Used only by migrations; the running API never connects with this role.
DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:15432/biztrust_dev
WEBHOOK_SECRET=generate-at-least-32-random-characters
# Configure a confidential Logto web application, not a browser SPA application.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Separate confidential staff client. Staff identities must be pre-provisioned
# as enabled operations memberships; this flow never self-enrols.
STAFF_OIDC_ISSUER=
STAFF_OIDC_CLIENT_ID=
STAFF_OIDC_CLIENT_SECRET=
# Public account enrolment maps only to this configured customer tenant.
CUSTOMER_TENANT=biztrust
