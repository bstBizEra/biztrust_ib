{
  "name": "biztrust-insurance-broker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production-assets",
    "db:local": "tsx scripts/setup-local.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:unit": "tsx --test tests/domain.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "test:startup": "node scripts/startup-smoke.mjs",
    "progress:build": "node scripts/build-progress.mjs",
    "progress:check": "node scripts/build-progress.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write src server shared scripts tests docs *.json *.ts *.html README.md",
    "format:check": "prettier --check src server shared scripts tests docs *.json *.ts *.html README.md",
    "security": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "verify": "npm run progress:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:startup && npm run test:e2e && npm run security"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-lao": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
